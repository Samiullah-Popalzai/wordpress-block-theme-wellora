
{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#52796F"
        },
        {
          "slug": "secondary",
          "name": "Secondary",
          "color": "#CAD8C5"
        },
        {
          "slug": "background",
          "name": "Background",
          "color": "#F8F7F2"
        },
        {
          "slug": "foreground",
          "name": "Foreground",
          "color": "#26332F"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#FFFFFF"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System Sans Serif",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "14px"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "18px"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "32px"
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "48px"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    }
  }
}
