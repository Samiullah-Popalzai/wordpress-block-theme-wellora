
{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "customGradient": false,
      "palette": [
        {
          "name": "Primary",
          "slug": "primary",
          "color": "#285943"
        },
        {
          "name": "Primary Dark",
          "slug": "primary-dark",
          "color": "#193D2D"
        },
        {
          "name": "Secondary",
          "slug": "secondary",
          "color": "#D6A15D"
        },
        {
          "name": "Background",
          "slug": "background",
          "color": "#FAF9F6"
        },
        {
          "name": "Surface",
          "slug": "surface",
          "color": "#FFFFFF"
        },
        {
          "name": "Text",
          "slug": "text",
          "color": "#252923"
        },
        {
          "name": "Muted",
          "slug": "muted",
          "color": "#777D75"
        },
        {
          "name": "Border",
          "slug": "border",
          "color": "#E8E9E3"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "fluid": true,
      "customFontWeight": true,
      "customLineHeight": true,
      "customLetterSpacing": true,
      "fontFamilies": [
        {
          "name": "System Sans",
          "slug": "system-sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        {
          "name": "Editorial Serif",
          "slug": "editorial-serif",
          "fontFamily": "Georgia, 'Times New Roman', serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "14px"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "18px"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "32px",
          "fluid": {
            "min": "26px",
            "max": "32px"
          }
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "48px",
          "fluid": {
            "min": "36px",
            "max": "64px"
          }
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "customSpacingSize": true,
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "12px"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "24px"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "48px"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "80px"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "dimensions": {
      "aspectRatio": true,
      "minHeight": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Soft",
          "slug": "soft",
          "shadow": "0 8px 30px rgba(37, 41, 35, 0.06)"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "shadow": "0 12px 40px rgba(37, 41, 35, 0.10)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|text"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system-sans",
      "fontSize": "18px",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "24px"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var:preset|color|text"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|editorial-serif",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|primary-dark"
          },
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "6px"
        },
        "typography": {
          "fontWeight": "600"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "24px",
            "right": "24px"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|primary-dark",
            "text": "#FFFFFF"
          }
        }
      }
    }
  }
}
